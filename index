><!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>  - Media Pembelajaran Interaktif</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .tab-btn.active {
            background-color: #2563eb;
            color: white;
            box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.39);
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="bg-blue-600 text-white p-2.5 rounded-xl shadow-lg shadow-blue-500/30">
                        <i class="fa-solid fa-superscript text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-slate-900 tracking-tight">Eksponen Explorer</h1>
                        <p class="text-xs text-slate-500 font-medium">Media Pembelajaran Matematika Interaktif</p>
                    </div>
                </div>
                
                <!-- Nav Tabs -->
                <nav class="hidden md:flex space-x-2 bg-slate-100 p-1.5 rounded-xl">
                    <button onclick="switchTab('materi')" id="tab-materi" class="tab-btn active px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200">
                        <i class="fa-solid fa-book-open mr-1.5"></i> Materi & Sifat
                    </button>
                    <button onclick="switchTab('simulasi')" id="tab-simulasi" class="tab-btn text-slate-600 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 hover:text-slate-900">
                        <i class="fa-solid fa-chart-line mr-1.5"></i> Simulasi Visual
                    </button>
                    <button onclick="switchTab('kuis')" id="tab-kuis" class="tab-btn text-slate-600 px-4 py-2 rounded-lg text-sm font-semibold transition-all duration-200 hover:text-slate-900">
                        <i class="fa-solid fa-pen-ruler mr-1.5"></i> Soal Kontekstual
                    </button>
                </nav>
            </div>
        </div>
        <!-- Mobile Navigation -->
        <div class="md:hidden flex border-t border-slate-200 bg-slate-50 p-1">
            <button onclick="switchTab('materi')" id="tab-materi-m" class="flex-1 py-2 text-xs font-semibold text-center text-blue-600 border-b-2 border-blue-600">Materi</button>
            <button onclick="switchTab('simulasi')" id="tab-simulasi-m" class="flex-1 py-2 text-xs font-semibold text-center text-slate-500">Simulasi</button>
            <button onclick="switchTab('kuis')" id="tab-kuis-m" class="flex-1 py-2 text-xs font-semibold text-center text-slate-500">Kuis & Soal</button>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- SECTION 1: MATERI & SIFAT -->
        <section id="sec-materi" class="space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 opacity-10 text-white">
                    <i class="fa-solid fa-calculator text-[250px]"></i>
                </div>
                <div class="relative z-10 max-w-2xl">
                    <span class="bg-blue-500/40 text-blue-100 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full border border-blue-400/30">Pengenalan Dasar</span>
                    <h2 class="text-3xl sm:text-4xl font-extrabold mt-3 mb-4 leading-tight">Apa itu Eksponen?</h2>
                    <p class="text-blue-100 text-base sm:text-lg leading-relaxed">
                        Eksponen (perpangkatan) adalah bentuk perkalian berulang dari suatu bilangan dengan dirinya sendiri sebanyak bilangan pangkatnya.
                    </p>
                    <div class="mt-6 inline-flex items-center space-x-3 bg-white/10 backdrop-blur-md px-5 py-3 rounded-2xl border border-white/20">
                        <span class="text-2xl font-bold italic">a<sup>n</sup> = a × a × a × ... × a</span>
                        <span class="text-xs text-blue-200 border-l border-white/20 pl-3">(sebanyak n faktor)</span>
                    </div>
                </div>
            </div>

            <!-- Sifat-sifat Eksponen Grid -->
            <div>
                <h3 class="text-2xl font-bold text-slate-900 mb-6 flex items-center">
                    <i class="fa-solid fa-list-check text-blue-600 mr-3"></i> 8 Sifat Utama Eksponen
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5" id="sifat-grid">
                    <!-- Cards dynamic / static HTML -->
                </div>
            </div>
        </section>

        <!-- SECTION 2: SIMULASI VISUAL -->
        <section id="sec-simulasi" class="hidden space-y-8">
            <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-slate-200">
                <div class="max-w-3xl mb-6">
                    <h2 class="text-2xl font-bold text-slate-900">Simulasi Pertumbuhan & Peluruhan Eksponensial</h2>
                    <p class="text-slate-600 mt-1">Eksponen sangat erat kaitannya dengan fenomena nyata seperti pembelahan sel/bakteri (pertumbuhan) atau peluruhan zat radioaktif.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <!-- Controls -->
                    <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 space-y-5">
                        <h3 class="font-bold text-slate-800 flex items-center">
                            <i class="fa-solid fa-sliders text-blue-600 mr-2"></i> Parameter Eksponen
                        </h3>

                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Nilai Awal (a)</label>
                            <input type="number" id="sim-a" value="10" class="w-full bg-white border border-slate-300 rounded-xl px-4 py-2.5 text-sm font-semibold focus:ring-2 focus:ring-blue-500 focus:outline-none">
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Basis / Rasio Pangkat (b)</label>
                            <input type="range" id="sim-b" min="0.1" max="3" step="0.1" value="2" class="w-full accent-blue-600">
                            <div class="flex justify-between text-xs text-slate-500 mt-1 font-medium">
                                <span>0.1 (Peluruhan)</span>
                                <span id="sim-b-val" class="font-bold text-blue-600">2</span>
                                <span>3 (Pertumbuhan)</span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold text-slate-600 uppercase mb-2">Batas Periode / Waktu (x)</label>
                            <input type="range" id="sim-x" min="1" max="10" step="1" value="5" class="w-full accent-blue-600">
                            <div class="flex justify-between text-xs text-slate-500 mt-1 font-medium">
                                <span>1</span>
                                <span id="sim-x-val" class="font-bold text-blue-600">5</span>
                                <span>10</span>
                            </div>
                        </div>

                        <div class="p-4 bg-blue-50 rounded-xl border border-blue-100 text-xs text-blue-900 font-medium leading-relaxed">
                            <i class="fa-solid fa-circle-info text-blue-600 mr-1"></i>
                            Rumus: <span class="font-bold">f(x) = a · b<sup>x</sup></span>
                        </div>
                    </div>

                    <!-- Chart Display -->
                    <div class="lg:col-span-2 flex flex-col justify-between">
                        <div class="bg-slate-900 p-4 rounded-2xl shadow-inner h-72 sm:h-80 relative">
                            <canvas id="exponentChart"></canvas>
                        </div>
                        <div class="mt-4 p-4 bg-emerald-50 border border-emerald-200 rounded-2xl flex items-center justify-between">
                            <div>
                                <p class="text-xs font-semibold text-emerald-800">Hasil Akhir f(x):</p>
                                <p class="text-2xl font-extrabold text-emerald-700" id="sim-result">320</p>
                            </div>
                            <div class="text-right">
                                <span id="sim-type" class="px-3 py-1 bg-emerald-200 text-emerald-800 rounded-full text-xs font-bold">Pertumbuhan Eksponensial</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: KUIS & SOAL KONTEKSTUAL -->
        <section id="sec-kuis" class="hidden space-y-8">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-3xl border border-slate-200">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">Latihan Soal Kontekstual Eksponen</h2>
                    <p class="text-slate-600 text-sm mt-1">Uji pemahamanmu pada aplikasi eksponen di dunia nyata.</p>
                </div>
                <div class="flex items-center space-x-4 bg-slate-50 px-4 py-2 rounded-2xl border border-slate-200">
                    <span class="text-sm font-semibold text-slate-600">Skor Kamu:</span>
                    <span id="score-display" class="text-2xl font-extrabold text-blue-600">0 / 0</span>
                </div>
            </div>

            <!-- List Soal -->
            <div id="quiz-container" class="space-y-6">
                <!-- Dynamically generated quiz cards -->
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-12 py-6 text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4">
            <p>© 2026 Media Pembelajaran Matematika Interaktif • Didesain untuk Pembelajaran Eksponen</p>
        </div>
    </footer>

    <script>
        // Data Sifat Eksponen
        const sifatData = [
            { title: "Perkalian Eksponen", formula: "a<sup>m</sup> × a<sup>n</sup> = a<sup>m+n</sup>", desc: "Jika basis sama dikali, pangkat dijumlahkan.", eg: "2³ × 2² = 2⁵ = 32" },
            { title: "Pembagian Eksponen", formula: "a<sup>m</sup> ÷ a<sup>n</sup> = a<sup>m-n</sup>", desc: "Jika basis sama dibagi, pangkat dikurangi.", eg: "3⁴ ÷ 3² = 3² = 9" },
            { title: "Perpangkatan Eksponen", formula: "(a<sup>m</sup>)<sup>n</sup> = a<sup>m×n</sup>", desc: "Pangkat yang dipangkatkan, nilainya dikali.", eg: "(2²)³ = 2⁶ = 64" },
            { title: "Perkalian Pangkat", formula: "(a × b)<sup>n</sup> = a<sup>n</sup> × b<sup>n</sup>", desc: "Perkalian di dalam kurung mendapat pangkat yang sama.", eg: "(2 × 3)² = 2² × 3² = 36" },
            { title: "Pembagian Pangkat", formula: "(a / b)<sup>n</sup> = a<sup>n</sup> / b<sup>n</sup>", desc: "Pembagian di dalam kurung mendapat pangkat yang sama.", eg: "(4 / 2)² = 4² / 2² = 4" },
            { title: "Pangkat Nol", formula: "a<sup>0</sup> = 1", desc: "Setiap bilangan (kecuali 0) dipangkatkan 0 hasilnya 1.", eg: "999⁰ = 1" },
            { title: "Pangkat Negatif", formula: "a<sup>-n</sup> = 1 / a<sup>n</sup>", desc: "Pangkat negatif menjadi penyebut dengan pangkat positif.", eg: "2⁻³ = 1 / 2³ = 1/8" },
            { title: "Pangkat Pecahan", formula: "a<sup>m/n</sup> = <sup>n</sup>√(a<sup>m</sup>)", desc: "Pangkat pecahan dapat diubah menjadi bentuk akar.", eg: "8<sup>2/3</sup> = ³√(8²) = 4" }
        ];

        // Data Soal Kontekstual
        const quizData = [
            {
                id: 1,
                context: "Pertumbuhan Bakteri (Biologi)",
                icon: "fa-vial-virus",
                question: "Sebuah kultur bakteri diawali dengan 100 bakteri. Bakteri tersebut membelah diri menjadi 2 setiap 1 jam. Berapa jumlah bakteri setelah 5 jam?",
                options: ["500 bakteri", "1.600 bakteri", "3.200 bakteri", "6.400 bakteri"],
                correct: 2,
                explanation: "Gunakan rumus pertumbuhan: N(t) = N₀ × 2ᵗ.<br>N(5) = 100 × 2⁵ = 100 × 32 = 3.200 bakteri."
            },
            {
                id: 2,
                context: "Bunga Majemuk (Ekonomi)",
                icon: "fa-piggy-bank",
                question: "Seseorang menabung di bank sebesar Rp 1.000.000 dengan bunga majemuk 10% per tahun. Berapa total tabungan setelah 3 tahun?",
                options: ["Rp 1.300.000", "Rp 1.331.000", "Rp 1.330.000", "Rp 1.400.000"],
                correct: 1,
                explanation: "Rumus bunga majemuk: M(t) = M₀ × (1 + i)ᵗ.<br>M(3) = 1.000.000 × (1 + 0,1)³ = 1.000.000 × (1,1)³ = 1.000.000 × 1,331 = Rp 1.331.000."
            },
            {
                id: 3,
                context: "Peluruhan Zat Radioaktif (Fisika)",
                icon: "fa-atom",
                question: "Suatu zat radioaktif memiliki massa awal 80 gram dan mengurai menjadi setengahnya setiap 2 jam. Berapa sisa zat tersebut setelah 6 jam?",
                options: ["10 gram", "20 gram", "40 gram", "5 gram"],
                correct: 0,
                explanation: "Jumlah periode peluruhan (n) = 6 jam / 2 jam = 3 kali.<br>Sisa zat = 80 × (1/2)³ = 80 × (1/8) = 10 gram."
            },
            {
                id: 4,
                context: "Penyebaran Informasi/Viral (Sosial)",
                icon: "fa-share-nodes",
                question: "Sebuah pesan berantai dikirimkan oleh 1 orang kepada 3 orang teman pada tahap pertama. Setiap orang yang menerima pesan melanjutkan dengan mengirimkannya ke 3 orang baru lainnya. Berapa banyak orang baru yang menerima pesan pada tahap ke-4?",
                options: ["12 orang", "27 orang", "81 orang", "243 orang"],
                correct: 2,
                explanation: "Jumlah penerima baru pada tahap ke-n disimbolkan dengan 3ⁿ.<br>Pada tahap ke-4: 3⁴ = 81 orang."
            }
        ];

        let userAnswers = {};
        let score = 0;
        let exponentChart = null;

        // Render Cards Sifat
        function renderSifat() {
            const container = document.getElementById('sifat-grid');
            container.innerHTML = sifatData.map(s => `
                <div class="glass-card p-5 rounded-2xl hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="text-xs font-bold text-blue-600 bg-blue-50 inline-block px-2.5 py-1 rounded-lg mb-3">
                            ${s.title}
                        </div>
                        <div class="text-lg font-extrabold text-slate-800 mb-2 font-mono bg-slate-100 p-2 rounded-xl text-center">
                            ${s.formula}
                        </div>
                        <p class="text-xs text-slate-600 leading-relaxed mb-4">${s.desc}</p>
                    </div>
                    <div class="border-t border-slate-100 pt-3 mt-auto">
                        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block">Contoh:</span>
                        <span class="text-xs font-bold text-emerald-600">${s.eg}</span>
                    </div>
                </div>
            `).join('');
        }

        // Render Kuis
        function renderQuiz() {
            const container = document.getElementById('quiz-container');
            container.innerHTML = quizData.map((q, idx) => `
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" id="quiz-card-${q.id}">
                    <div class="flex items-center space-x-2 text-xs font-bold text-blue-600 mb-3 bg-blue-50 w-fit px-3 py-1 rounded-full">
                        <i class="fa-solid ${q.icon}"></i>
                        <span>Soal ${idx + 1}: ${q.context}</span>
                    </div>
                    <p class="text-slate-800 font-semibold mb-4 text-sm sm:text-base">${q.question}</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                        ${q.options.map((opt, oIdx) => `
                            <button onclick="selectAnswer(${q.id}, ${oIdx})" id="opt-${q.id}-${oIdx}" class="text-left p-3 rounded-xl border border-slate-200 text-sm font-medium hover:bg-slate-50 transition-all flex items-center justify-between">
                                <span>${opt}</span>
                                <i class="fa-regular fa-circle text-slate-300" id="icon-${q.id}-${oIdx}"></i>
                            </button>
                        `).join('')}
                    </div>
                    <div id="explanation-${q.id}" class="hidden p-4 rounded-xl text-xs sm:text-sm leading-relaxed border mt-3"></div>
                </div>
            `).join('');
        }

        // Answer Logic
        function selectAnswer(qId, optionIdx) {
            if (userAnswers[qId] !== undefined) return; // Prevent re-answering

            userAnswers[qId] = optionIdx;
            const q = quizData.find(item => item.id === qId);
            const isCorrect = optionIdx === q.correct;

            // Highlight chosen option
            const btn = document.getElementById(`opt-${qId}-${optionIdx}`);
            const icon = document.getElementById(`icon-${qId}-${optionIdx}`);

            if (isCorrect) {
                btn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-800');
                icon.className = "fa-solid fa-circle-check text-emerald-600";
                score++;
            } else {
                btn.classList.add('bg-rose-50', 'border-rose-500', 'text-rose-800');
                icon.className = "fa-solid fa-circle-xmark text-rose-600";
                
                // Highlight correct one
                const correctBtn = document.getElementById(`opt-${qId}-${q.correct}`);
                correctBtn.classList.add('bg-emerald-50', 'border-emerald-500', 'text-emerald-800');
            }

            // Show explanation
            const expBox = document.getElementById(`explanation-${qId}`);
            expBox.classList.remove('hidden');
            if (isCorrect) {
                expBox.classList.add('bg-emerald-50', 'border-emerald-200', 'text-emerald-900');
                expBox.innerHTML = `<strong><i class="fa-solid fa-check mr-1"></i> Benar!</strong><br>${q.explanation}`;
            } else {
                expBox.classList.add('bg-rose-50', 'border-rose-200', 'text-rose-900');
                expBox.innerHTML = `<strong><i class="fa-solid fa-xmark mr-1"></i> Kurang Tepat.</strong><br>${q.explanation}`;
            }

            // Update Score Display
            document.getElementById('score-display').innerText = `${score} / ${quizData.length}`;
        }

        // Tab Switching
        function switchTab(tab) {
            const tabs = ['materi', 'simulasi', 'kuis'];
            tabs.forEach(t => {
                document.getElementById(`sec-${t}`).classList.add('hidden');
                
                // Desktop tab style
                const tabBtn = document.getElementById(`tab-${t}`);
                if (tabBtn) {
                    tabBtn.classList.remove('active');
                    tabBtn.classList.add('text-slate-600');
                }

                // Mobile tab style
                const tabBtnM = document.getElementById(`tab-${t}-m`);
                if (tabBtnM) {
                    tabBtnM.classList.remove('text-blue-600', 'border-b-2', 'border-blue-600');
                    tabBtnM.classList.add('text-slate-500');
                }
            });

            document.getElementById(`sec-${tab}`).classList.remove('hidden');
            
            // Active Desktop
            const activeBtn = document.getElementById(`tab-${tab}`);
            if (activeBtn) {
                activeBtn.classList.add('active');
                activeBtn.classList.remove('text-slate-600');
            }

            // Active Mobile
            const activeBtnM = document.getElementById(`tab-${tab}-m`);
            if (activeBtnM) {
                activeBtnM.classList.add('text-blue-600', 'border-b-2', 'border-blue-600');
                activeBtnM.classList.remove('text-slate-500');
            }

            if (tab === 'simulasi' && !exponentChart) {
                initChart();
            }
        }

        // Chart Initialization & Update
        function initChart() {
            const ctx = document.getElementById('exponentChart').getContext('2d');
            exponentChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [{
                        label: 'f(x) = a · bˣ',
                        data: [],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.2)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 3,
                        pointBackgroundColor: '#2563eb',
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#94a3b8', font: { family: 'Plus Jakarta Sans' } } }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255,255,255,0.1)' },
                            ticks: { color: '#94a3b8' }
                        },
                        y: {
                            grid: { color: 'rgba(255,255,255,0.1)' },
                            ticks: { color: '#94a3b8' }
                        }
                    }
                }
            });
            updateChart();
        }

        function updateChart() {
            const a = parseFloat(document.getElementById('sim-a').value) || 0;
            const b = parseFloat(document.getElementById('sim-b').value);
            const maxX = parseInt(document.getElementById('sim-x').value);

            document.getElementById('sim-b-val').innerText = b;
            document.getElementById('sim-x-val').innerText = maxX;

            const labels = [];
            const data = [];

            for (let x = 0; x <= maxX; x++) {
                labels.push(`x = ${x}`);
                data.push(Number((a * Math.pow(b, x)).toFixed(2)));
            }

            exponentChart.data.labels = labels;
            exponentChart.data.datasets[0].data = data;
            exponentChart.update();

            // Update result card
            const lastVal = data[data.length - 1];
            document.getElementById('sim-result').innerText = lastVal.toLocaleString('id-ID');

            const typeLabel = document.getElementById('sim-type');
            if (b > 1) {
                typeLabel.innerText = "Pertumbuhan Eksponensial";
                typeLabel.className = "px-3 py-1 bg-emerald-200 text-emerald-800 rounded-full text-xs font-bold";
            } else if (b < 1) {
                typeLabel.innerText = "Peluruhan Eksponensial";
                typeLabel.className = "px-3 py-1 bg-amber-200 text-amber-800 rounded-full text-xs font-bold";
            } else {
                typeLabel.innerText = "Konstan";
                typeLabel.className = "px-3 py-1 bg-slate-200 text-slate-800 rounded-full text-xs font-bold";
            }
        }

        // Event Listeners for Simulation Controls
        document.getElementById('sim-a').addEventListener('input', updateChart);
